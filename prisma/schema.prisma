generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  BLOCKED
  COMPLETED
  ARCHIVED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

enum ApprovalType {
  PURCHASE_ORDER
  INVENTORY_ADJUSTMENT
  STOCK_TRANSFER
  PRODUCT_COST_CHANGE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum ActivityType {
  SCAN
  FLAG
  BLOCK
  UNBLOCK
  RESTOCK
  STOCK_IN
  STOCK_OUT
  APPROVAL
  FINANCE
  USER
  SYSTEM
}

model User {
  id                    String   @id @default(cuid())
  name                  String
  email                 String   @unique
  passwordHash          String
  role                  UserRole @default(STAFF)
  isActive              Boolean  @default(true)
  publicIdentifier      String?  @unique
  businessId            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business              Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdProjects       Project[] @relation("ProjectOwner")
  assignedTasks         ProjectTask[] @relation("TaskAssignee")
  movements             StockMovement[]
  purchaseOrders        PurchaseOrder[] @relation("PurchaseOrderCreator")
  requestedApprovals    ApprovalRequest[] @relation("ApprovalRequestedBy")
  reviewedApprovals     ApprovalRequest[] @relation("ApprovalReviewedBy")
  notifications         Notification[]
  permissionOverrides   PermissionOverride[]
  transactions          Transaction[] @relation("TransactionCreator")
  avatarUrl             String?

  @@index([email])
  @@index([businessId])
  @@index([publicIdentifier])
}

model Warehouse {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  location    String?
  isPrimary   Boolean  @default(false)
  businessId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business        Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  inventoryItems  InventoryItem[]
  outgoingMoves   StockMovement[]   @relation("SourceWarehouse")
  incomingMoves   StockMovement[]   @relation("DestinationWarehouse")
}

model Category {
  id         String    @id @default(cuid())
  name       String    @unique
  businessId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  products Product[]
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  email       String?
  phone       String?
  address     String?
  businessId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business       Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  products       Product[]
}

model Product {
  id             String    @id @default(cuid())
  sku            String    @unique
  barcode        String?   @unique
  name           String
  description    String?
  unit           String
  reorderPoint   Int       @default(0)
  reorderQty     Int       @default(0)
  isActive       Boolean   @default(true)
  categoryId     String?
  supplierId     String?
  businessId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business       Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inventoryItems InventoryItem[]
  movements      StockMovement[]
  purchaseLines  PurchaseOrderLine[]
  flaggedAt      DateTime?
  flaggedReason  String?
  imageUrl       String?
}

model InventoryItem {
  id              String    @id @default(cuid())
  productId       String
  warehouseId     String
  quantityOnHand  Int       @default(0)
  reservedQty     Int       @default(0)
  availableQty    Int       @default(0)
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

model StockMovement {
  id                    String           @id @default(cuid())
  type                  StockMovementType
  quantity              Int
  reason                String?
  reference             String?
  productId             String
  performedByUserId     String?
  sourceWarehouseId     String?
  destinationWarehouseId String?
  createdAt             DateTime         @default(now())

  product              Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  performedByUser      User?      @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)
  sourceWarehouse      Warehouse? @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  destinationWarehouse Warehouse? @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)
}

model Project {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  status      ProjectStatus  @default(PLANNED)
  startDate   DateTime?
  dueDate     DateTime?
  ownerUserId String?
  businessId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  owner    User?      @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  business Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  tasks    ProjectTask[]
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      String   @default("todo")
  priority    String   @default("medium")
  assigneeId  String?
  dueDate     DateTime?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}

model PurchaseOrder {
  id              String               @id @default(cuid())
  orderNumber     String               @unique
  supplierId      String?
  status          PurchaseOrderStatus  @default(DRAFT)
  orderedAt       DateTime?
  expectedAt      DateTime?
  receivedAt      DateTime?
  notes           String?
  createdByUserId String?
  businessId      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  supplier   Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy  User?      @relation("PurchaseOrderCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  business   Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  lines      PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId  String
  productId       String
  quantityOrdered Int
  quantityReceived Int      @default(0)
  unitCost        Decimal   @db.Decimal(14, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model ApprovalRequest {
  id                String         @id @default(cuid())
  type              ApprovalType
  title             String
  entity           String
  entityId         String?
  requestedByUserId String?
  reviewedByUserId  String?
  status            ApprovalStatus  @default(PENDING)
  reason            String?
  businessImpact    String?
  reviewerNote      String?
  requestedAt       DateTime        @default(now())
  reviewedAt        DateTime?

  requestedBy User? @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ApprovalReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model PermissionOverride {
  id         String   @id @default(cuid())
  userId     String?
  role       UserRole?
  permission String
  granted    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@unique([role, permission])
  @@index([userId])
  @@index([role])
}

model Business {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  publicIdentifier String  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  warehouses      Warehouse[]
  products        Product[]
  suppliers       Supplier[]
  categories      Category[]
  projects        Project[]
  purchaseOrders  PurchaseOrder[]
  transactions    Transaction[]
  activities      Activity[]

  @@index([slug])
  @@index([publicIdentifier])
}

model Transaction {
  id              String          @id @default(cuid())
  type            TransactionType
  amount          Decimal         @db.Decimal(14, 2)
  currency        String?
  category        String
  description     String?
  reference       String?
  occurredAt      DateTime        @default(now())
  createdByUserId String?
  businessId      String?
  createdAt       DateTime        @default(now())

  createdBy User?     @relation("TransactionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([businessId, createdAt])
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  message    String
  actorName  String?
  actorRole  String?
  targetType String?
  targetId   String?
  metadata   Json?
  businessId String?
  createdAt  DateTime     @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([type, createdAt])
}

model AppSetting {
  id        String   @id @default("singleton")
  currency  String?
  updatedAt DateTime @updatedAt
}
